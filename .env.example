# ── React 웹앱 ──────────────────────────────────────
VITE_API_BASE_URL=https://your-api-server.a.run.app/api
VITE_APP_NAME=Korean Auction App
VITE_DEV_MODE=true

# ── Telegram Bot (로컬 개발용) ───────────────────────
# GCP 배포 시에는 Secret Manager에 저장하세요 (하드코딩 금지)
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_USER_IDS=123456789

# ── 공유 백엔드 API ──────────────────────────────────
API_SERVER_URL=http://localhost:8000

# ── GCP Cloud Run (배포 시만 설정) ───────────────────
WEBHOOK_URL=https://sentinel-bot-XXXXX.a.run.app
PORT=8080
