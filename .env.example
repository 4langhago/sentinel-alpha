# ── React 웹앱 ──────────────────────────────────────
VITE_API_BASE_URL=https://your-api-server.a.run.app/api
VITE_APP_NAME=Korean Auction App
VITE_DEV_MODE=true

# 검색 페이지 지도 패널(카카오맵) API 키. 없으면 시도/시군구 타일 히트맵으로 자동 대체된다.
VITE_KAKAO_MAP_KEY=

# ── Supabase 인증 (회원가입/로그인) ──────────────────
# Supabase 대시보드 > Project Settings > API 에서 복사
# 비워두면 localStorage 폴백 모드로 동작한다(계정이 브라우저에만 저장됨).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── 경매 데이터 수집 (Netlify Functions 서버 전용) ───
# 공공데이터포털(data.go.kr) 법원경매정보 서비스키. 없으면 mock 데이터로 폴백.
COURT_API_KEY=

# ── Telegram Bot (로컬 개발용) ───────────────────────
# GCP 배포 시에는 Secret Manager에 저장하세요 (하드코딩 금지)
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_USER_IDS=123456789

# ── 공유 백엔드 API ──────────────────────────────────
API_SERVER_URL=http://localhost:8000

# ── GCP Cloud Run (배포 시만 설정) ───────────────────
WEBHOOK_URL=https://sentinel-bot-XXXXX.a.run.app
PORT=8080

# ── 국토교통부 실거래가 (Netlify Functions 서버 전용) ─
# data.go.kr 에서 아래 3개를 활용신청한 뒤, 마이페이지의
# "일반 인증키(Decoding)" 를 넣으세요. (Encoding 키를 넣어도 자동 처리됩니다)
#
#   1. 국토교통부_아파트 매매 실거래 상세 자료   https://www.data.go.kr/data/15126468/openapi.do
#   2. 국토교통부_아파트 전월세 자료             (RTMSDataSvcAptRent)
#   3. 국토교통부_오피스텔 매매 자료             https://www.data.go.kr/data/15126464/openapi.do
#   4. 국토교통부_상업업무용 부동산 매매 자료     https://www.data.go.kr/data/15126463/openapi.do
#   5. 국토교통부_토지 매매 신고 자료             https://www.data.go.kr/data/15126466/openapi.do
#
# 신청한 종목만 수집되고, 미신청 종목은 자동으로 건너뜁니다.
#
# 미설정 시 샘플 데이터로 폴백하며, 화면에 "샘플 데이터" 배지가 표시됩니다.
MOLIT_API_KEY=

# 수동 수집 트리거 보호용 토큰 (임의의 긴 문자열).
# 설정하면 POST /trigger/refresh 로 즉시 수집을 실행할 수 있다.
REFRESH_TOKEN=
