{
  "name": "auction-insight",
  "version": "1.0.0",
  "description": "AI 기반 한국 법원 경매 분석 플랫폼",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:prod": "NODE_ENV=production vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy:firebase": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "axios": "^1.6.8",
    "lucide-react": "^0.372.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "terser": "^5.31.0"
  }
}
