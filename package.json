{
  "name": "sise-insight",
  "version": "1.0.0",
  "description": "국토교통부 실거래가 기반 부동산 시세 분석 플랫폼",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:prod": "NODE_ENV=production vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy:firebase": "npm run build && firebase deploy --only hosting",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:all": "concurrently -n api,web -c cyan,green \"node scripts/dev-api.mjs\" \"vite\"",
    "dev:mobile": "concurrently -n api,web -c cyan,green \"node scripts/dev-api.mjs\" \"vite --host\"",
    "collect": "node scripts/collect-local.mjs",
    "onbid:dump": "node scripts/dump-onbid-sample.mjs",
    "onbid:probe": "node scripts/probe-onbid.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0",
    "@supabase/supabase-js": "^2.112.2",
    "axios": "^1.6.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.372.0",
    "pretendard": "^1.3.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.4",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "terser": "^5.31.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
