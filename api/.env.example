# ── FastAPI 서버 설정 ─────────────────────────────────
PORT=8000

# ── 데이터 소스 (Phase 1: mock / Phase 2: 실제 API) ───
DATA_SOURCE=mock

# ── 법원경매정보 API (실제 연동 시 입력) ──────────────
COURT_API_KEY=your_court_api_key_here
COURT_API_URL=https://api.courtauction.go.kr

# ── CORS 허용 출처 ────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.web.app
