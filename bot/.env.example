# ── 필수 설정 ────────────────────────────────────────
# @BotFather 에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 허용할 텔레그램 user_id (쉼표 구분, @userinfobot 으로 확인)
ALLOWED_USER_IDS=123456789

# ── 백엔드 API ────────────────────────────────────────
# 로컬: http://localhost:8000 / GCP: https://your-api.a.run.app
API_SERVER_URL=http://localhost:8000

# ── Webhook 설정 (GCP 배포 시만 입력) ────────────────
# 로컬 개발 시에는 비워두면 자동으로 Polling 모드로 실행됩니다
WEBHOOK_URL=

# Cloud Run 수신 포트 (기본값 8080)
PORT=8080
